  <!-- ====================================================================
       SCRIPTS: DATASETS, LEAFLET MAPS, CHART.JS, LOGIC
       ==================================================================== -->
  <script>
    /* 1. MOCK DATASETS (Realistic, consistent with SIH UTIS schema) */
    const BUSES_DATA = [
      { id: "BUS-1024", route: "Route 12", routeName: "Pune Stn - Univ. Rd", status: "Delayed", speed: 24, eta: "7 min", nextStop: "Shivaji Nagar", lat: 18.5295, lng: 73.8480, driver: "Ramesh Jadhav", type: "Electric AC (Olectra)", battery: 68, delay: 8, roadScore: "Critical (5.8 IRI)" },
      { id: "BUS-1025", route: "Route 12", routeName: "Pune Stn - Univ. Rd", status: "Active", speed: 38, eta: "3 min", nextStop: "FC Road", lat: 18.5235, lng: 73.8420, driver: "Suresh Patil", type: "CNG Standard (Tata)", battery: 76, delay: 0, roadScore: "Good (2.1 IRI)" },
      { id: "BUS-1042", route: "Route 08", routeName: "Swargate - Katraj", status: "Active", speed: 32, eta: "5 min", nextStop: "Bibwewadi", lat: 18.4750, lng: 73.8580, driver: "Mahesh Deshmukh", type: "BRTS Articulated", battery: 84, delay: 1, roadScore: "Good (1.9 IRI)" },
      { id: "BUS-2081", route: "Route 21", routeName: "Hadapsar - Kothrud", status: "Active", speed: 29, eta: "9 min", nextStop: "Deccan Gymkhana", lat: 18.5160, lng: 73.8410, driver: "Vikas Shinde", type: "Electric AC (Olectra)", battery: 91, delay: 2, roadScore: "Moderate (3.4 IRI)" },
      { id: "BUS-3012", route: "Route 34", routeName: "Aundh - Hinjawadi", status: "Active", speed: 35, eta: "4 min", nextStop: "Wakad Chowk", lat: 18.5980, lng: 73.7630, driver: "Sunil Kadam", type: "CNG Standard (Tata)", battery: 62, delay: 0, roadScore: "Good (2.4 IRI)" },
      { id: "BUS-4120", route: "Route 101", routeName: "Nigdi - Pune Stn", status: "Critical", speed: 8, eta: "22 min", nextStop: "Khadki Bazar", lat: 18.5620, lng: 73.8310, driver: "Pradeep Joshi", type: "CNG Standard (Tata)", battery: 45, delay: 18, roadScore: "Moderate (3.8 IRI)" }
    ];

    const ALERTS_DATA = [
      { id: "INC-1042", type: "Road Condition", category: "Pothole Anomaly", location: "Sancheti Chowk Flyover", severity: "Critical", busId: "BUS-1024", time: "10:42 AM", status: "Pending Review", rec: "Inspect affected road section. Vertical accelerometer shock 2.8G indicates 8cm pavement depression." },
      { id: "INC-1043", type: "Traffic Flow", category: "Congestion Bottleneck", location: "JM Road Deccan Corner", severity: "Warning", busId: "BUS-2081", time: "10:35 AM", status: "Active", rec: "Vehicular speed dropped to 11 km/h. Divert feeder lines 12B via FC Road." },
      { id: "INC-1044", type: "Environmental", category: "AQI PM2.5 Spike", location: "Hadapsar Industrial Approach", severity: "Warning", busId: "BUS-1088", time: "10:18 AM", status: "Investigating", rec: "Air index reached 148 µg/m³. Alert Pune Pollution Control Board monitoring node." },
      { id: "INC-1045", type: "Vehicle Diagnostic", category: "Engine Temperature Alert", location: "Khadki Bazar", severity: "Critical", busId: "BUS-4120", time: "09:55 AM", status: "Dispatching Standby", rec: "Engine coolant temperature 96°C. Standby unit BUS-4130 dispatched from Khadki depot." }
    ];

    /* 2. LEAFLET MAP INITIALIZATION */
    let dashboardMap = null;
    let fullGisMap = null;
    let mapMarkers = [];

    function initDashboardMap() {
      if (dashboardMap) return;
      
      dashboardMap = L.map('dashboardMap', {
        center: [18.5204, 73.8567], // Pune Coordinates
        zoom: 13,
        zoomControl: false
      });

      L.control.zoom({ position: 'bottomright' }).addTo(dashboardMap);

      // NextAdmin clean map tiles
      L.tileLayer('https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png', {
        attribution: '&copy; CartoDB & OpenStreetMap',
        maxZoom: 19
      }).addTo(dashboardMap);

      renderMapMarkers(dashboardMap);
    }

    function renderMapMarkers(mapInstance) {
      mapMarkers.forEach(m => mapInstance.removeLayer(m));
      mapMarkers = [];

      // Bus Markers
      BUSES_DATA.forEach(bus => {
        let color = '#10B981';
        if (bus.status === 'Delayed') color = '#F59E0B';
        if (bus.status === 'Critical') color = '#EF4444';

        const customIcon = L.divIcon({
          className: 'custom-bus-pin',
          html: `<div style="background-color: ${color}; width: 28px; height: 28px; border-radius: 50%; border: 3px solid #fff; box-shadow: 0 2px 8px rgba(0,0,0,0.3); display: flex; align-items: center; justify-content: center; color: #fff; font-size: 11px; font-weight: 800;">🚌</div>`,
          iconSize: [28, 28],
          iconAnchor: [14, 14]
        });

        const marker = L.marker([bus.lat, bus.lng], { icon: customIcon }).addTo(mapInstance);
        
        const popupContent = `
          <div style="font-family: 'Inter', sans-serif; min-width: 180px; padding: 4px;">
            <div style="font-weight: 800; font-size: 14px; color: #1E293B; margin-bottom: 2px;">${bus.id}</div>
            <div style="font-size: 11px; color: #64748B; margin-bottom: 8px;">${bus.routeName}</div>
            <div style="font-size: 12px; display: grid; gap: 4px;">
              <div><strong>Status:</strong> <span style="color: ${color}; font-weight: 700;">${bus.status}</span></div>
              <div><strong>Speed:</strong> ${bus.speed} km/h</div>
              <div><strong>Road Score:</strong> ${bus.roadScore}</div>
              <div><strong>Battery:</strong> ${bus.battery}%</div>
            </div>
            <button onclick="openAlertModal('INC-1042')" style="margin-top: 8px; width: 100%; padding: 4px; background: #123B63; color: #fff; border: none; border-radius: 4px; font-size: 11px; font-weight: 600; cursor: pointer;">Telemetry Details</button>
          </div>
        `;
        marker.bindPopup(popupContent);
        mapMarkers.push(marker);
      });

      // Pothole Marker
      const potholeIcon = L.divIcon({
        className: 'pothole-pin',
        html: `<div style="background: #EF4444; width: 24px; height: 24px; border-radius: 6px; border: 2px solid #fff; box-shadow: 0 2px 6px rgba(0,0,0,0.3); display: flex; align-items: center; justify-content: center; color: #fff; font-size: 11px;">⚠️</div>`,
        iconSize: [24, 24]
      });
      const potholeMarker = L.marker([18.5295, 73.8480], { icon: potholeIcon }).addTo(mapInstance);
      potholeMarker.bindPopup(`
        <div style="padding: 4px;">
          <strong style="color: #EF4444;">Severe Pothole Cluster</strong><br>
          <span style="font-size: 11px; color: #64748B;">Sancheti Chowk • IRI: 5.8</span><br>
          <button onclick="openAlertModal('INC-1042')" style="margin-top: 6px; padding: 4px 8px; background: #EF4444; color: #fff; border: none; border-radius: 4px; font-size: 11px; cursor: pointer;">Inspect Defect</button>
        </div>
      `);
      mapMarkers.push(potholeMarker);
    }

    function initFullGisMap() {
      if (fullGisMap) return;
      fullGisMap = L.map('fullGisMap', {
        center: [18.5204, 73.8567],
        zoom: 14
      });
      L.tileLayer('https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png', {
        attribution: '&copy; CartoDB & OSM'
      }).addTo(fullGisMap);
      renderMapMarkers(fullGisMap);
    }

    /* 3. CHART.JS INITIALIZATION (NextAdmin Look) */
    let velocityChart = null;
    let donutChart = null;

    function initCharts() {
      // Traffic Velocity Line/Bar Chart
      const ctxVelocity = document.getElementById('trafficVelocityChart');
      if (ctxVelocity && !velocityChart) {
        velocityChart = new Chart(ctxVelocity, {
          type: 'line',
          data: {
            labels: ['06:00', '08:00', '10:00', '12:00', '14:00', '16:00', '18:00', '20:00', '22:00'],
            datasets: [
              {
                label: 'Fleet Speed (km/h)',
                data: [38, 22, 26, 34, 32, 24, 18, 28, 36],
                borderColor: '#3B82F6',
                backgroundColor: 'rgba(59, 130, 246, 0.08)',
                fill: true,
                tension: 0.4,
                borderWidth: 2.5,
                pointRadius: 3,
                pointBackgroundColor: '#3B82F6'
              },
              {
                label: 'Congestion Level (%)',
                data: [15, 68, 54, 30, 38, 62, 85, 48, 20],
                borderColor: '#8B5CF6',
                backgroundColor: 'rgba(139, 92, 246, 0.04)',
                fill: true,
                tension: 0.4,
                borderWidth: 2,
                borderDash: [4, 4],
                pointRadius: 2
              }
            ]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
              legend: {
                position: 'top',
                labels: { boxWidth: 12, font: { family: 'Inter', size: 11 } }
              }
            },
            scales: {
              x: { grid: { display: false } },
              y: { 
                grid: { color: 'rgba(226, 232, 240, 0.6)' },
                ticks: { font: { family: 'Inter', size: 10 } }
              }
            }
          }
        });
      }

      // Fleet Donut Chart
      const ctxDonut = document.getElementById('fleetDonutChart');
      if (ctxDonut && !donutChart) {
        donutChart = new Chart(ctxDonut, {
          type: 'doughnut',
          data: {
            labels: ['Electric AC', 'CNG Standard', 'BRTS'],
            datasets: [{
              data: [38, 42, 20],
              backgroundColor: ['#3B82F6', '#10B981', '#8B5CF6'],
              borderWidth: 0,
              hoverOffset: 4
            }]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            cutout: '72%',
            plugins: {
              legend: { display: false }
            }
          }
        });
      }

      // Analytics Charts
      const ctxAnalyticsSpeed = document.getElementById('analyticsSpeedChart');
      if (ctxAnalyticsSpeed) {
        new Chart(ctxAnalyticsSpeed, {
          type: 'bar',
          data: {
            labels: ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'],
            datasets: [{
              label: 'Avg Corridor Punctuality (%)',
              data: [84, 82, 79, 86, 81, 91, 94],
              backgroundColor: '#3B82F6',
              borderRadius: 6
            }]
          },
          options: { responsive: true, maintainAspectRatio: false }
        });
      }

      const ctxAnalyticsPothole = document.getElementById('analyticsPotholeTrendChart');
      if (ctxAnalyticsPothole) {
        new Chart(ctxAnalyticsPothole, {
          type: 'line',
          data: {
            labels: ['Week 1', 'Week 2', 'Week 3', 'Week 4'],
            datasets: [{
              label: 'Potholes Repaired (MoHUA SLA)',
              data: [12, 19, 14, 23],
              borderColor: '#10B981',
              tension: 0.3
            }]
          },
          options: { responsive: true, maintainAspectRatio: false }
        });
      }
    }

    /* 4. TABLE POPULATION & INTERACTIONS */
    function populateTables() {
      // Dashboard incidents table
      const dashTbody = document.getElementById('dashboardIncidentsTableBody');
      if (dashTbody) {
        dashTbody.innerHTML = ALERTS_DATA.map(alert => `
          <tr>
            <td><strong>#${alert.id}</strong></td>
            <td>${alert.category}</td>
            <td>${alert.location}</td>
            <td><code>${alert.busId}</code></td>
            <td>
              <span class="status-badge ${alert.severity === 'Critical' ? 'badge-critical' : 'badge-moderate'}">
                ${alert.severity}
              </span>
            </td>
            <td>${alert.time}</td>
            <td><span style="font-size: 11px; font-weight: 600; color: var(--text-muted);">${alert.status}</span></td>
            <td>
              <button class="btn btn-outline" style="height: 26px; padding: 0 8px; font-size: 11px;" onclick="openAlertModal('${alert.id}')">
                Action
              </button>
            </td>
          </tr>
        `).join('');
      }

      // Live Fleet Table
      const fleetTbody = document.getElementById('liveFleetTableBody');
      if (fleetTbody) {
        fleetTbody.innerHTML = BUSES_DATA.map(bus => `
          <tr>
            <td><strong>${bus.id}</strong></td>
            <td>${bus.route} (${bus.routeName})</td>
            <td>Shivaji Nagar Central</td>
            <td>
              <span class="status-badge ${bus.status === 'Active' ? 'badge-good' : (bus.status === 'Delayed' ? 'badge-moderate' : 'badge-critical')}">
                ${bus.status}
              </span>
            </td>
            <td><strong>${bus.speed} km/h</strong></td>
            <td>
              <div style="display: flex; align-items: center; gap: 6px;">
                <div style="width: 40px; height: 6px; background: #E2E8F0; border-radius: 3px; overflow: hidden;">
                  <div style="width: ${bus.battery}%; height: 100%; background: ${bus.battery > 50 ? '#10B981' : '#F59E0B'};"></div>
                </div>
                <span style="font-size: 11px;">${bus.battery}%</span>
              </div>
            </td>
            <td><span style="font-size: 11px; color: ${bus.roadScore.includes('Critical') ? '#EF4444' : '#10B981'}; font-weight: 600;">${bus.roadScore}</span></td>
            <td>Just now</td>
            <td>
              <button class="btn btn-outline" style="height: 26px; padding: 0 8px; font-size: 11px;" onclick="focusBusOnMap('${bus.id}')">
                Track
              </button>
            </td>
          </tr>
        `).join('');
      }

      // All Alerts Table
      const alertsTbody = document.getElementById('allAlertsTableBody');
      if (alertsTbody) {
        alertsTbody.innerHTML = ALERTS_DATA.map(alert => `
          <tr>
            <td><strong>#${alert.id}</strong></td>
            <td>${alert.type}</td>
            <td>${alert.location}</td>
            <td>
              <span class="status-badge ${alert.severity === 'Critical' ? 'badge-critical' : 'badge-moderate'}">
                ${alert.severity}
              </span>
            </td>
            <td>${alert.time}</td>
            <td>${alert.busId}</td>
            <td>${alert.status}</td>
            <td>
              <button class="btn btn-primary" style="height: 26px; padding: 0 8px; font-size: 11px;" onclick="openAlertModal('${alert.id}')">
                Inspect & Resolve
              </button>
            </td>
          </tr>
        `).join('');
      }
    }

    /* 5. VIEW SWITCHING LOGIC */
    function switchView(viewId, btnElem) {
      document.querySelectorAll('.view-panel').forEach(v => v.classList.remove('active'));
      const targetView = document.getElementById(`view-${viewId}`);
      if (targetView) targetView.classList.add('active');

      if (btnElem) {
        document.querySelectorAll('.nav-item-btn').forEach(b => b.classList.remove('active'));
        btnElem.classList.add('active');
      }

      // Update Top Title
      const titles = {
        'dashboard': ['Dashboard', 'Real-time overview of urban conditions collected through public transport fleet'],
        'fleet': ['Live Fleet Monitoring', 'Real-time GPS telemetry, sensor packets, and battery diagnostics for 128 transit units'],
        'map': ['GIS Command Center', 'Spatial heatmaps of traffic congestion, road defects, and mobile environmental telemetry'],
        'traffic': ['Traffic & Flow Velocity', 'Corridor congestion bottlenecks, speed reduction rates, and signal performance'],
        'roads': ['Road Roughness & Defect Scanner', 'Automated pothole detection, International Roughness Index (IRI), and repair queue'],
        'environment': ['Environmental & AQI Telemetry', 'Mobile transit sensing of particulate matter (PM2.5), heat microclimate, and noise dB'],
        'alerts': ['Incidents & Control Queue', 'Urgent urban alerts flagged by edge vision and accelerometer sensors'],
        'analytics': ['AI Urban Analytics', 'Deep learning predictions on traffic patterns and road surface wear rates'],
        'reports': ['Official Government Reports', 'Exportable compliance audits for MoHUA and municipal infrastructure planners'],
        'status': ['Platform System Health', 'Telemetry ingestion servers, spatial databases, and sensor node uptime status'],
        'settings': ['Control Preferences', 'Configure display zones, alert sirens, and update intervals']
      };

      if (titles[viewId]) {
        document.getElementById('pageTitleText').innerText = titles[viewId][0];
        document.getElementById('pageSubtitleText').innerText = titles[viewId][1];
      }

      if (viewId === 'map') {
        setTimeout(initFullGisMap, 100);
      }
    }

    /* 6. MODAL & ALERT DETAIL ACTIONS */
    function openAlertModal(alertId) {
      const alert = ALERTS_DATA.find(a => a.id === alertId) || ALERTS_DATA[0];
      document.getElementById('modalAlertIdTitle').innerText = `Alert #${alert.id}`;
      document.getElementById('modalAlertType').innerText = `${alert.type} (${alert.category})`;
      document.getElementById('modalAlertLocation').innerText = alert.location;
      document.getElementById('modalAlertBus').innerText = `${alert.busId} • Edge Accelerometer Node`;
      document.getElementById('modalAlertTime').innerText = `${alert.time} IST`;
      document.getElementById('modalAlertRec').innerText = alert.rec;
      document.getElementById('alertDetailModal').classList.add('active');
    }

    function closeAlertModal() {
      document.getElementById('alertDetailModal').classList.remove('active');
    }

    function handleBackdropClick(e) {
      if (e.target.id === 'alertDetailModal') closeAlertModal();
    }

    function resolveModalAlert() {
      alert('Action Dispatched: Municipal Pothole Repair Unit #PUN-PW-04 allocated. ETA to site: 22 mins.');
      closeAlertModal();
    }

    /* 7. REAL-TIME SIMULATION & LIVE CLOCK */
    function startSimulationClock() {
      setInterval(() => {
        const now = new Date();
        const timeStr = now.toLocaleTimeString('en-IN', { hour12: false }) + ' IST';
        document.getElementById('liveIstClock').innerText = timeStr;
      }, 1000);

      // Jitter bus coordinates slightly to simulate motion
      setInterval(() => {
        BUSES_DATA.forEach(bus => {
          bus.lat += (Math.random() - 0.5) * 0.0004;
          bus.lng += (Math.random() - 0.5) * 0.0004;
          bus.speed = Math.max(12, Math.min(48, Math.round(bus.speed + (Math.random() - 0.5) * 3)));
        });
        if (dashboardMap) renderMapMarkers(dashboardMap);
        if (fullGisMap) renderMapMarkers(fullGisMap);
      }, 4000);
    }

    function simulateDataSync() {
      const activeEl = document.getElementById('kpiActiveVehicles');
      activeEl.innerText = "128";
      alert('Live Telemetry Handshake: 128 mobile units synced with edge server.');
    }

    /* 8. UI HELPERS & TOGGLES */
    function toggleSidebarCollapse() {
      document.getElementById('appSidebar').classList.toggle('collapsed');
      document.getElementById('appMain').classList.toggle('expanded');
    }

    function toggleDarkMode() {
      document.body.classList.toggle('dark-mode');
    }

    function toggleNotifDropdown() {
      document.getElementById('notifDropdown').classList.toggle('active');
    }

    function handleGlobalSearch(e) {
      if (e.key === 'Enter') {
        const query = e.target.value.toLowerCase();
        alert(`Searching UTIS fleet and GIS registry for: "${query}"...`);
      }
    }

    function filterFleetTable() {
      const search = document.getElementById('fleetSearchInput').value.toLowerCase();
      const status = document.getElementById('fleetStatusFilter').value;
      const rows = document.querySelectorAll('#liveFleetTableBody tr');
      rows.forEach(row => {
        const text = row.innerText.toLowerCase();
        const matchesSearch = text.includes(search);
        const matchesStatus = status === 'all' || text.includes(status.toLowerCase());
        row.style.display = (matchesSearch && matchesStatus) ? '' : 'none';
      });
    }

    function focusBusOnMap(busId) {
      switchView('dashboard');
      const bus = BUSES_DATA.find(b => b.id === busId);
      if (bus && dashboardMap) {
        dashboardMap.setView([bus.lat, bus.lng], 16);
      }
    }

    function setMapLayer(layer, btn) {
      document.querySelectorAll('.pill-tab-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
    }

    function setFullMapLayer(layer, btn) {
      btn.parentElement.querySelectorAll('.pill-tab-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
    }

    function downloadSampleReport(filename) {
      const csvContent = "data:text/csv;charset=utf-8,VehicleID,Route,Speed,RoadQuality,AQI,Status\nBUS-1024,Route 12,24,Critical,82,Delayed\nBUS-1025,Route 12,38,Good,80,Active\nBUS-1042,Route 08,32,Good,75,Active\n";
      const encodedUri = encodeURI(csvContent);
      const link = document.createElement("a");
      link.setAttribute("href", encodedUri);
      link.setAttribute("download", filename);
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
    }

    // ON DOM LOAD
    window.addEventListener('DOMContentLoaded', () => {
      initDashboardMap();
      initCharts();
      populateTables();
      startSimulationClock();
    });
  </script>
</body>
</html>
